<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forge_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add a game manually"
        android:textColor="@color/forge_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="For titles GameForge's auto-detection missed. Pick anything from your installed apps."
        android:textColor="@color/forge_text_dim"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/searchBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@color/forge_surface"
        android:hint="Search installed apps"
        android:padding="12dp"
        android:textColor="@color/forge_text"
        android:textColorHint="@color/forge_text_dim"
        android:inputType="text" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pickList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp" />
</LinearLayout>
